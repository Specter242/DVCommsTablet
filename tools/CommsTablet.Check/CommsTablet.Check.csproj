<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contract check of the mod against the installed game's assemblies, run
    under Mono by scripts/check.sh. Game assemblies are copied to bin/
    (gitignored) so Mono can load them; nothing here touches Unity's native
    side.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CommsTablet/CommsTablet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(DvModManagerDir)/0Harmony.dll" />
    <Reference Include="UnityModManager" HintPath="$(DvModManagerDir)/UnityModManager.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(DvManagedDir)/Assembly-CSharp.dll" />
    <Reference Include="DV.ThingTypes" HintPath="$(DvManagedDir)/DV.ThingTypes.dll" />
    <Reference Include="DV.Utils" HintPath="$(DvManagedDir)/DV.Utils.dll" />
    <Reference Include="DV.RailTrack" HintPath="$(DvManagedDir)/DV.RailTrack.dll" />
    <Reference Include="UnityEngine" HintPath="$(DvManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DvManagedDir)/UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(DvManagedDir)/UnityEngine.AudioModule.dll" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(DvManagedDir)/UnityEngine.PhysicsModule.dll" />
  </ItemGroup>

</Project>
