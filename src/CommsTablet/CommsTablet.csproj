<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CommsTablet</AssemblyName>
    <RootNamespace>CommsTablet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game and loader assemblies are referenced in place and never copied. -->
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(DvModManagerDir)/0Harmony.dll" Private="false" />
    <Reference Include="UnityModManager" HintPath="$(DvModManagerDir)/UnityModManager.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(DvManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="BezierCurves" HintPath="$(DvManagedDir)/BezierCurves.dll" Private="false" />
    <Reference Include="DV.CabControls.Spec" HintPath="$(DvManagedDir)/DV.CabControls.Spec.dll" Private="false" />
    <Reference Include="DV.Interaction" HintPath="$(DvManagedDir)/DV.Interaction.dll" Private="false" />
    <Reference Include="DV.Inventory" HintPath="$(DvManagedDir)/DV.Inventory.dll" Private="false" />
    <Reference Include="DV.PointSet" HintPath="$(DvManagedDir)/DV.PointSet.dll" Private="false" />
    <Reference Include="DV.RailTrack" HintPath="$(DvManagedDir)/DV.RailTrack.dll" Private="false" />
    <Reference Include="DV.ThingTypes" HintPath="$(DvManagedDir)/DV.ThingTypes.dll" Private="false" />
    <Reference Include="DV.Utils" HintPath="$(DvManagedDir)/DV.Utils.dll" Private="false" />
    <Reference Include="DV.Localization" HintPath="$(DvManagedDir)/DV.Localization.dll" Private="false" />
    <Reference Include="DV.Common" HintPath="$(DvManagedDir)/DV.Common.dll" Private="false" />
    <Reference Include="DV.NAudio" HintPath="$(DvManagedDir)/DV.NAudio.dll" Private="false" />
    <Reference Include="DV.UIFramework" HintPath="$(DvManagedDir)/DV.UIFramework.dll" Private="false" />
    <Reference Include="DV.Preferences" HintPath="$(DvManagedDir)/DV.Preferences.dll" Private="false" />
    <Reference Include="DV.UI" HintPath="$(DvManagedDir)/DV.UI.dll" Private="false" />
    <Reference Include="DV.UserManagement" HintPath="$(DvManagedDir)/DV.UserManagement.dll" Private="false" />
    <Reference Include="I2.Localization" HintPath="$(DvManagedDir)/I2.Localization.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(DvManagedDir)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="net.smkd.vector3d" HintPath="$(DvManagedDir)/net.smkd.vector3d.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(DvManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(DvManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(DvManagedDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DvManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(DvManagedDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(DvManagedDir)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(DvManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(DvManagedDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(DvManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(DvManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(DvManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.VRModule" HintPath="$(DvManagedDir)/UnityEngine.VRModule.dll" Private="false" />
    <Reference Include="WorldStreamer" HintPath="$(DvManagedDir)/WorldStreamer.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Double Track's switch maps (Books/DoubleTrackBooks.cs), kept in the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Books/routemap-normal.json" LogicalName="CommsTablet.Books.routemap-normal.json" />
    <EmbeddedResource Include="Books/booklet-normal.json" LogicalName="CommsTablet.Books.booklet-normal.json" />
  </ItemGroup>

</Project>
